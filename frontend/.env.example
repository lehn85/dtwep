# ==============================================================================
# DTEP Frontend Environment Configuration (.env)
# ==============================================================================

# [Dev Server Binding]
# Set to '0.0.0.0' to listen on all network interfaces (allows remote SSH / LAN access via http://dtpc:5173 or IP).
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173

# [Backend Target for Vite Proxy]
# Vite dev server proxies requests from frontend (/api and /ws) to this backend.
# - If backend runs locally on the same machine: http://127.0.0.1:8000
# - If backend runs on another remote host/machine: http://dtpc:8000 (or http://<IP>:8000)
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# [Direct API & WebSocket URLs - Optional]
# Leave empty/commented out to use Vite proxy defaults (/api and /ws/run relative to current browser origin).
# Only uncomment and set these if you want the browser to connect directly to the backend bypassing the proxy:
# VITE_API_BASE_URL=http://dtpc:8000/api
# VITE_WS_URL=ws://dtpc:8000/ws/run
